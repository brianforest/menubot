# ── Telegram ───────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram numeric user IDs allowed to use the bot.
# Leave empty to allow everyone. Find your id via @userinfobot.
ALLOWED_USER_IDS=

# ── Claude (menu reading + translation) ────────────────────
ANTHROPIC_API_KEY=
# Vision-capable model used to read the menu photos.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── GitHub Pages publishing ────────────────────────────────
# A fine-grained PAT with "Contents: Read and write" on the target repo.
GITHUB_TOKEN=
# Where generated menu pages are committed (this can be the menubot repo itself).
GITHUB_OWNER=brianforest
GITHUB_REPO=surrey-hills-menu
GITHUB_BRANCH=main
# Folder inside the repo that GitHub Pages serves (Settings → Pages → /docs).
PAGES_DIR=docs
# Public base URL of the Pages site (no trailing slash).
# Default if blank: https://<owner>.github.io/<repo>
PAGES_BASE_URL=

# ── Debug ──────────────────────────────────────────────────
# Set to "on" to append a per-stage timing summary (⏱️) to the Telegram reply.
# The structured "[timing] …" console line is logged regardless. Default off.
DEBUG_TIMING=off
